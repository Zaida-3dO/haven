# ── Haven environment ────────────────────────────────────────────────────
# Copy to `.env` and fill in. `.env` is gitignored and must never be
# committed — this file ships placeholders only. See docs/SECURITY.md.

# Server
HAVEN_HOST=0.0.0.0
HAVEN_PORT=8080
HAVEN_LOG_LEVEL=info

# SQLite database file. In Docker this points at the mounted volume.
HAVEN_DB_PATH=./data/haven.db

# Encrypts widget credentials at rest in SQLite.
# Generate with: openssl rand -base64 32
HAVEN_SECRET_KEY=

# ── Connector credentials ────────────────────────────────────────────────
# All optional — a connector without credentials renders a "not configured"
# tile rather than failing. None of these ever reach the browser.

# OpenWeatherMap (weather widget)
HAVEN_OPENWEATHER_API_KEY=

# qBittorrent (torrents widget)
HAVEN_QBITTORRENT_URL=
HAVEN_QBITTORRENT_USER=
HAVEN_QBITTORRENT_PASS=

# Home Assistant (notices widget)
HAVEN_HA_URL=
HAVEN_HA_TOKEN=

# Calendar — a Google Calendar "secret address in iCal format" URL.
# This is a bearer credential: anyone holding it can read the calendar.
HAVEN_CALENDAR_ICS_URL=

# GitHub token for the releases API (raises the rate limit; public repos
# work unauthenticated at a lower limit).
HAVEN_GITHUB_TOKEN=
