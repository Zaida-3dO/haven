# of a public repo. Mount them at runtime instead.
assets/private/
uploads/

# ── Build output ─────────────────────────────────────────────────────────
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# ── Tooling noise ────────────────────────────────────────────────────────
.playwright-mcp/
playwright-report/
test-results/
.vite/
.cache/

# ── Editor / OS ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp

# ── Claude Code internal ─────────────────────────────────────────────────
.claude/settings.local.json

# Private, un-redacted working docs. Never committed.
.private/
