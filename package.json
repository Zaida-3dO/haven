{
  "name": "haven",
  "version": "0.1.0",
  "private": false,
  "description": "A widget-based, self-hosted personal dashboard.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zaida-3dO/haven.git"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server",
    "build": "npm run build --workspace=web",
    "start": "npm run start --workspace=server",
    "test": "npm run test --workspaces --if-present && npm run test:refresher",
    "test:e2e": "npm run build --workspace=web && playwright test",
    "test:refresher": "node --test \"version-refresher/test/**/*.test.js\"",
    "lint": "npm run lint --workspaces --if-present && eslint version-refresher",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.6.2"
  }
}
